GROQ_API_KEY=paste_your_groq_api_key_here

# OpenAlex API key (free): https://openalex.org/settings/api
# Without it, requests share a tiny daily budget with everyone on your network (→ 429 errors).
OPENALEX_API_KEY=paste_your_openalex_api_key_here

# Optional: your email for OpenAlex polite pool
OPENALEX_MAILTO=you@example.com

# Gemini API key (free): https://aistudio.google.com/apikey
# Used for embeddings (semantic rerank). Without it the rerank step is skipped.
GEMINI_API_KEY=paste_your_gemini_api_key_here
